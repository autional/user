{
  "name": "@autional/end-user-portal",
  "version": "0.1.0",
  "private": true,
  "description": "End-User Portal — Personal dashboard, profile, security, sessions, and notifications (Vite + React Router + Tailwind)",
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/gen-env.mjs && vite --port 13104",
    "build": "node ../../scripts/gen-env.mjs && tsc && vite build",
    "preview": "vite preview --port 13104",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist",
    "analyze": "ANALYZE=true vite build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@autional/shared": "0.1.0-rc.33",
    "@autional/tailwind-preset": "0.1.0-rc.10",
    "@autional/tokens": "0.1.0-rc.16",
    "@autional/ui": "0.1.0-rc.48",
    "@hookform/resolvers": "3.10.0",
    "@tanstack/react-query": "5.100.9",
    "antd": "6.5.0",
    "dayjs": "1.11.23",
    "i18next": "26.0.10",
    "i18next-browser-languagedetector": "8.2.1",
    "lucide-react": "0.509.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-hook-form": "7.78.0",
    "react-i18next": "17.0.7",
    "react-router": "7.15.0",
    "workbox-precaching": "7.4.1",
    "workbox-window": "7.4.1",
    "zod": "3.23.8",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@autional/eslint-config": "0.1.0-rc.1",
    "@autional/tsconfig": "0.1.0-rc",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/addon-interactions": "8.6.14",
    "@storybook/react": "8.6.18",
    "@storybook/react-vite": "8.6.18",
    "@storybook/test": "8.6.15",
    "@tailwindcss/typography": "^0.5.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.4.0",
    "autoprefixer": "10.5.0",
    "eslint": "10.12.0",
    "jsdom": "29.1.1",
    "postcss": "8.5.14",
    "rollup-plugin-visualizer": "7.0.1",
    "storybook": "8.6.18",
    "tailwindcss": "3.4.19",
    "typescript": "5.8.3",
    "typescript-eslint": "8.71.0",
    "vite": "6.4.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "3.2.0"
  }
}
